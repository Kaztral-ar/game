{
  "expo": {
    "name": "Number Rush",
    "slug": "game",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "owner": "kaztrals-team",
    "android": {
      "package": "com.kaztral.numberrush"
    },
    "ios": {
      "bundleIdentifier": "com.kaztral.numberrush"
    },
    "extra": {
      "eas": {
        "projectId": "332e9574-94e6-4894-a2b4-f054039d744c"
      }
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6906509746436244~8981717455",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ]
    ]
  }
}
